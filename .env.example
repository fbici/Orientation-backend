# Template only. Supply real secrets outside Git (Render environment settings).
# Use JDBC syntax for the new Render PostgreSQL connection; require SSL.
SPRING_DATASOURCE_URL=jdbc:postgresql://REPLACE_HOST:5432/REPLACE_DATABASE?sslmode=require
SPRING_DATASOURCE_USERNAME=
SPRING_DATASOURCE_PASSWORD=
JWT_SECRET=
# Generate JWT_SECRET randomly (at least 32 bytes); never reuse historical defaults.
APP_BASE_URL=
CORS_ALLOWED_ORIGINS=
SENDGRID_ENABLED=false
SENDGRID_API_KEY=
SENDGRID_FROM_EMAIL=
# Optional custom reset page; defaults to APP_BASE_URL/auth/reset-password.
PASSWORD_RESET_URL=
REGISTRATION_TENANT_CODE=DEFAULT
# Must be writable by UID 10001; mount a persistent Render disk here.
STORAGE_DIR=/app/uploads
TESSERACT_COMMAND=tesseract
OCR_LANGUAGES=fra+eng
OCR_TIMEOUT_SECONDS=45
BOOTSTRAP_ENABLED=false
BOOTSTRAP_EMAIL=
BOOTSTRAP_PASSWORD=
BOOTSTRAP_TENANT_CODE=
# Local docker-compose.prod.yml PostgreSQL/Grafana only; no production values.
DB_USERNAME=orientation_user
DB_PASSWORD=
GRAFANA_PASSWORD=
